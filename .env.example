# Create an OAuth client in Copernicus Data Space Ecosystem and paste its credentials here.
# Never expose COPERNICUS_CLIENT_SECRET to the browser or commit a real .env file.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Reserved for a future legal, documented RosHydromet integration. Do not add credentials
# until a public contract and terms of use have been verified.
ROSHYDROMET_WMS_URL=
ROSHYDROMET_USERNAME=
ROSHYDROMET_PASSWORD=
ROSHYDROMET_API_KEY=
